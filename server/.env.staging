# Staging Environment Variables
# Copy this to .env.staging for staging deployment

# === DATABASE ===
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
SUPABASE_ANON_KEY=your-staging-anon-key

# === PAYMENT ===
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret_key

# === EMAIL ===
EMAIL_USER=staging@yourdomain.com
EMAIL_PASS=your-staging-app-password
ADMIN_EMAIL=staging-admin@yourdomain.com

# === SECURITY ===
JWT_SECRET=staging-jwt-secret-change-in-production
SESSION_SECRET=staging-session-secret-change-in-production

# === MONITORING ===
SENTRY_DSN=your-staging-sentry-dsn

# === DEPLOYMENT ===
NODE_ENV=staging
PORT=5000
FRONTEND_URL=http://localhost:8080

# === RATE LIMITING ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# === CORS ===
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000